#!/bin/sh
. "$DIR/helper.sh"

@test "runs the PHP version of its folder" {
  [ "$(in_image php -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;')" = "$PHP_MAJOR_MINOR" ]
}

@test "loads the required PHP extensions" {
  run in_image php -m
  [ $status -eq 0 ]
  match "$stdout" '/^bcmath$/'
  match "$stdout" '/^calendar$/'
  match "$stdout" '/^ctype$/'
  match "$stdout" '/^exif$/'
  match "$stdout" '/^fileinfo$/'
  match "$stdout" '/^ftp$/'
  match "$stdout" '/^gd$/'
  match "$stdout" '/^intl$/'
  match "$stdout" '/^json$/'
  match "$stdout" '/^mbstring$/'
  match "$stdout" '/^memcached$/'
  match "$stdout" '/^openssl$/'
  match "$stdout" '/^pcntl$/'
  match "$stdout" '/^PDO$/'
  match "$stdout" '/^pdo_mysql$/'
  match "$stdout" '/^pdo_pgsql$/'
  match "$stdout" '/^redis$/'
  match "$stdout" '/^sockets$/'
  match "$stdout" '/^tokenizer$/'
  match "$stdout" '/^xdebug$/'
  match "$stdout" '/^xml$/'
  match "$stdout" '/^xsl$/'
  match "$stdout" '/^zip$/'
  match "$stdout" '/^Zend OPcache$/'
}

@test "uses the development php.ini" {
  run in_image php --ini
  [ $status -eq 0 ]
  match "$stdout" '/^Loaded Configuration File: +"?\/usr\/local\/etc\/php\/php\.ini"?$/'
  [ "$(in_image php -r 'echo ini_get("display_errors");')" = 1 ]
}

@test "raises memory_limit to 1024M" {
  [ "$(in_image php -r 'echo ini_get("memory_limit");')" = 1024M ]
}

@test "converts UTF-8 with iconv" {
  run in_image php -r 'var_dump(iconv("UTF-8", "UTF-8//IGNORE", "This is the Euro symbol €"));'
  [ $status -eq 0 ]
  match "$stdout" 'string(27) "This is the Euro symbol €"'
}
