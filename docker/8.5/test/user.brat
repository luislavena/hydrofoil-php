#!/bin/sh
. "$DIR/helper.sh"

@test "creates user with uid and gid 1000" {
  [ "$(in_image id -u user)" = 1000 ]
  [ "$(in_image id -g user)" = 1000 ]
  [ "$(in_image id -gn user)" = user ]
}

@test "uses /home/user as home of user" {
  [ "$(in_image sh -c 'echo "$HOME"')" = /home/user ]
  [ "$(in_image stat -c '%u:%g' /home/user)" = 1000:1000 ]
}

@test "installs fixuid as setuid root" {
  [ "$(in_image stat -c '%a %U %G' /usr/local/bin/fixuid)" = '4755 root root' ]
  in_image test -f /etc/fixuid/config.yml
}

@test "remaps user to the uid and gid of the host" {
  run docker run --rm -u 1001:1001 "$IMAGE" sh -c 'id -un; id -gn; stat -c %u:%g /home/user'
  [ $status -eq 0 ]
  [ "$(cat "$stdout")" = "$(printf 'user\nuser\n1001:1001')" ]
}

@test "gives user passwordless sudo" {
  [ "$(in_image sudo -n id -u)" = 0 ]
}
