#!/bin/sh
. "$DIR/helper.sh"

@test "runs NodeJS tools through the mise shims" {
  [ "$(in_image sh -c 'command -v node')" = /usr/local/share/mise/shims/node ]
  [ "$(in_image sh -c 'command -v npm')" = /usr/local/share/mise/shims/npm ]
  [ "$(in_image sh -c 'command -v pnpm')" = /usr/local/share/mise/shims/pnpm ]
  in_image node --version
  in_image npm --version
  in_image pnpm --version
}

@test "ships no Yarn" {
  [ "$(in_image sh -c 'command -v yarn || echo missing')" = missing ]
}

@test "installs development tools in /usr/local/bin" {
  [ "$(in_image sh -c 'command -v mise')" = /usr/local/bin/mise ]
  [ "$(in_image sh -c 'command -v composer')" = /usr/local/bin/composer ]
  [ "$(in_image sh -c 'command -v overmind')" = /usr/local/bin/overmind ]
  [ "$(in_image sh -c 'command -v watchexec')" = /usr/local/bin/watchexec ]
  in_image mise --version
  in_image composer --version
  in_image overmind --version
  in_image watchexec --version
}

@test "installs common command line tools" {
  in_image sh -c 'command -v 7z'
  in_image sh -c 'command -v curl'
  in_image sh -c 'command -v git'
  in_image sh -c 'command -v ssh'
  in_image sh -c 'command -v tmux'
  in_image sh -c 'command -v unzip'
}

@test "installs database clients" {
  in_image mysql --version
  in_image mysqldump --version
  in_image pg_dump --version
  in_image pg_restore --version
}

@test "installs time zone data" {
  in_image test -e /usr/share/zoneinfo/UTC
}
