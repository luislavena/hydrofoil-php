# syntax = docker/dockerfile:1.4

ARG PHP_VERSION=8.5.10
ARG BASE_DISTRO=trixie

# ---
# 1. Use Debian (${BASE_DISTRO}) version of PHP
FROM php:${PHP_VERSION}-cli-${BASE_DISTRO} AS base

# ---
# 2. Upgrade system and installed dependencies for security patches
#
# Also enable to keep copies of downloaded packages for faster rebuilds
RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    apt-get update; \
    apt-get upgrade -y

# ---
# 3. Setup non-root user (fixuid)
#
RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    export USERNAME=user; \
    # install needed packages
    { \
      apt-get update; \
      apt-get install --no-install-recommends -y \
          sudo \
      ; \
    }; \
    # create non-root user & give passwordless sudo
    { \
        groupadd --gid 1000 ${USERNAME}; \
        useradd --uid 1000 --gid 1000 --home-dir /home/${USERNAME} --create-home --shell /bin/bash ${USERNAME}; \
        mkdir -p /etc/sudoers.d; \
        echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}; \
        # cleanup backup copies generated by `groupadd` and `useradd`
        rm -f \
          /etc/gshadow- \
          /etc/subgid- \
          /etc/subuid- \
        ; \
    }; \
    # Install fixuid
    { \
        cd /tmp; \
        export FIXUID_VERSION=0.6.0; \
        case "$(arch)" in \
        x86_64) \
            export \
                FIXUID_ARCH=amd64 \
                FIXUID_SHA256=8c47f64ec4eec60e79871796ea4097ead919f7fcdedace766da9510b78c5fa14 \
            ; \
            ;; \
        aarch64) \
            export \
                FIXUID_ARCH=arm64 \
                FIXUID_SHA256=827e0b480c38470b5defb84343be7bb4e85b9efcbf3780ac779374e8b040a969 \
            ; \
            ;; \
        esac; \
        curl --fail -Lo fixuid.tar.gz https://github.com/boxboat/fixuid/releases/download/v${FIXUID_VERSION}/fixuid-${FIXUID_VERSION}-linux-${FIXUID_ARCH}.tar.gz; \
        echo "${FIXUID_SHA256} *fixuid.tar.gz" | sha256sum -c - >/dev/null 2>&1; \
        tar -xf fixuid.tar.gz; \
        mv fixuid /usr/local/bin/; \
        chmod u+s /usr/local/bin/fixuid; \
        rm fixuid.tar.gz; \
    }; \
    # Generate fixuid config
    mkdir -p /etc/fixuid; \
    { \
        echo "user: ${USERNAME}"; \
        echo "group: ${USERNAME}"; \
    } | tee /etc/fixuid/config.yml

# Adjust ENTRYPOINT
ENTRYPOINT [ "/usr/local/bin/fixuid", "-q" ]
CMD [ "/bin/bash", "-i" ]

# ---
# 4. Install dependencies and common packages
#
RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    apt-get update; \
    apt-get install --no-install-recommends -y \
        git \
        openssh-client \
        tzdata \
    ;

# ---
# 5. Install PHP extensions and tweak configuration
#
# TODO: enable opcache for CLI
RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    # ---
    # Configure PHP in development mode
    cp "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"; \
    # ---
    # Additional tweaks for development
    { \
        echo "memory_limit=1024M"; \
    } | tee $PHP_INI_DIR/conf.d/zz-hydrofoil-tweaks.ini; \
    # ---
    # Use `docker-php-ext-install` to ease installation of PHP
    # extensions
    #
    # Use `IPE_GD_WITHOUTAVIF=1` to disable gd AVIF support
    #
    # Ref: https://github.com/mlocati/docker-php-extension-installer
    export \
      PHP_EXT_INSTALLER_VERSION=2.11.12 \
      PHP_EXT_INSTALLER_SHA256SUM=7c133ae4b9490d912287188c62ea570729cfa74f0ea357e4be672ce696b4aa29 \
      IPE_GD_WITHOUTAVIF=1 \
    ; \
    cd /tmp; \
    { \
      curl --fail -Lo install-php-extensions \
        https://github.com/mlocati/docker-php-extension-installer/releases/download/${PHP_EXT_INSTALLER_VERSION}/install-php-extensions; \
      echo "${PHP_EXT_INSTALLER_SHA256SUM} *install-php-extensions" | sha256sum -c - >/dev/null 2>&1; \
      chmod +x install-php-extensions; \
    }; \
    # ---
    # Install common PHP extensions
    #
    # (no need to install mbstring, pdo, tokenizer or xml as they are already part of base image)
    ./install-php-extensions \
      bcmath \
      calendar \
      exif \
      ftp \
      gd \
      intl \
      memcached-stable \
      pcntl \
      pdo_mysql \
      pdo_pgsql \
      redis-stable \
      sockets \
      xdebug-stable \
      xsl \
      zip \
    ; \
    # opcache is required and built into PHP as of 8.5, per the "Make
    # OPcache required" RFC (https://wiki.php.net/rfc/make_opcache_required),
    # so there is no shared extension left to enable
    # remove PHP extension installer
    rm -f ./install-php-extensions

# ---
# 6. Install NodeJS and pnpm (via mise)
#
# The system shims folder resolves the tools declared in /etc/mise/config.toml.
# The user shims folder goes last, so tools a user adds later also resolve.
# That folder does not exist in a fresh image, which is harmless.
ENV PATH=/usr/local/share/mise/shims:$PATH:/home/user/.local/share/mise/shims

RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    cd /tmp; \
    # ---
    # python3 is needed by node-gyp to build native modules
    { \
      apt-get update; \
      apt-get install --no-install-recommends -y \
          python3 \
      ; \
    }; \
    # ---
    # mise: installs and pins NodeJS and pnpm
    #
    # Ref: https://mise.jdx.dev/
    { \
        export MISE_VERSION=2026.9.9; \
        case "$(arch)" in \
        x86_64) \
            export \
                MISE_ARCH=x64 \
                MISE_SHA256=e4767e4854af5daeff2191b2bbdc94f834742a23efad591dbd33187861d41604 \
            ; \
            ;; \
        aarch64) \
            export \
                MISE_ARCH=arm64 \
                MISE_SHA256=5f72efaa1265c9c3562ecf8d22e6623b5278700bd7ef1014a785d0ce1d1a90b2 \
            ; \
            ;; \
        esac; \
        curl --fail -Lo mise.tar.gz https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-${MISE_ARCH}.tar.gz; \
        echo "${MISE_SHA256} *mise.tar.gz" | sha256sum -c - >/dev/null 2>&1; \
        tar -xf mise.tar.gz; \
        mv mise/bin/mise /usr/local/bin/; \
        rm -rf mise.tar.gz mise; \
    }; \
    # ---
    # System-wide tool versions and settings
    #
    # `not_found_auto_install` off stops a shim downloading a version at run
    # time. `not_found_system_fallback` off stops a shim running an unrelated
    # command with the same name. Together they turn a project that pins its
    # own version into a clear message instead of a surprise.
    mkdir -p /etc/mise; \
    { \
        echo '[tools]'; \
        echo 'node = "24.21.0"'; \
        echo 'pnpm = "12.4.2"'; \
        echo ''; \
        echo '[settings]'; \
        echo 'not_found_auto_install = false'; \
        echo 'not_found_system_fallback = false'; \
    } | tee /etc/mise/config.toml; \
    # `--system` installs outside any home folder, so every user shares them
    mise install --system; \
    chmod -R a+rX /usr/local/share/mise; \
    # smoke tests
    [ "$(command -v mise)" = '/usr/local/bin/mise' ]; \
    [ "$(command -v node)" = '/usr/local/share/mise/shims/node' ]; \
    [ "$(command -v npm)" = '/usr/local/share/mise/shims/npm' ]; \
    [ "$(command -v pnpm)" = '/usr/local/share/mise/shims/pnpm' ]; \
    mise --version; \
    node --version; \
    npm --version; \
    pnpm --version

# ---
# 7. Install other development utilities
#
# watchexec and Overmind stay as direct downloads. mise installs these through
# its `github:` backend, which calls the GitHub API. That API allows only 60
# requests per hour without a token, which would make builds fail at random.
RUN --mount=type=cache,sharing=private,target=/var/cache/apt \
    --mount=type=cache,sharing=private,target=/var/lib/apt \
    --mount=type=tmpfs,target=/var/log \
    set -eux; \
    cd /tmp; \
    # ---
    # Database clients (PostgreSQL, MariaDB/MySQL)
    { \
        apt-get update; \
        apt-get install --no-install-recommends -y \
            mariadb-client \
            postgresql-client \
        ; \
    }; \
    # ---
    # Composer (needs 7z, unzip)
    { \
        apt-get update; \
        apt-get install --no-install-recommends -y \
            p7zip-full \
            unzip \
        ; \
        export \
            COMPOSER_VERSION=2.10.3 \
            COMPOSER_SHA256=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6 \
        ; \
        curl --fail -Lo composer.phar https://getcomposer.org/download/${COMPOSER_VERSION}/composer.phar; \
        echo "${COMPOSER_SHA256} *composer.phar" | sha256sum -c - >/dev/null 2>&1; \
        chmod +x composer.phar; \
        mv composer.phar /usr/local/bin/composer; \
    }; \
    # ---
    # Overmind (needs tmux)
    { \
        apt-get update; \
        apt-get install --no-install-recommends -y \
            tmux \
        ; \
        export \
            OVERMIND_VERSION=2.5.1 \
        ; \
        case "$(arch)" in \
        x86_64) \
            export \
                OVERMIND_ARCH=amd64 \
                OVERMIND_SHA256=a17159b8e97d13f3679a4e8fbc9d4747f82d5af9f6d32597b72821378b5d0b6f \
            ; \
            ;; \
        aarch64) \
            export \
                OVERMIND_ARCH=arm64 \
                OVERMIND_SHA256=42cb6d79c8adcf4c68dfb2ddf09e63a0803b023af5b17d42e05ccbfa4b86bee2 \
            ; \
            ;; \
        esac; \
        curl --fail -Lo overmind.gz https://github.com/DarthSim/overmind/releases/download/v${OVERMIND_VERSION}/overmind-v${OVERMIND_VERSION}-linux-${OVERMIND_ARCH}.gz; \
        echo "${OVERMIND_SHA256} *overmind.gz" | sha256sum -c - >/dev/null 2>&1; \
        gunzip overmind.gz; \
        chmod +x overmind; \
        mv overmind /usr/local/bin/; \
    }; \
    # ---
    # Watchexec
    { \
        export \
            WATCHEXEC_VERSION=2.7.3 \
        ; \
        case "$(arch)" in \
        x86_64) \
            export \
                WATCHEXEC_ARCH=x86_64 \
                WATCHEXEC_SHA256=8ace3a1d2e752d189f28b6766311d58f155ab977fae66aba60b111ec8aec2f64 \
            ; \
            ;; \
        aarch64) \
            export \
                WATCHEXEC_ARCH=aarch64 \
                WATCHEXEC_SHA256=02b3e2beddf96fef5fb2b88849902e3cf9e96da87968bdfb7a488700d64142cc \
            ; \
            ;; \
        esac; \
        curl --fail -Lo watchexec.tar.xz https://github.com/watchexec/watchexec/releases/download/v${WATCHEXEC_VERSION}/watchexec-${WATCHEXEC_VERSION}-${WATCHEXEC_ARCH}-unknown-linux-gnu.tar.xz; \
        echo "${WATCHEXEC_SHA256} *watchexec.tar.xz" | sha256sum -c - >/dev/null 2>&1; \
        tar -xf watchexec.tar.xz; \
        mv watchexec-${WATCHEXEC_VERSION}-${WATCHEXEC_ARCH}-unknown-linux-gnu/watchexec /usr/local/bin/; \
        rm -rf watchexec.tar.xz watchexec-${WATCHEXEC_VERSION}-${WATCHEXEC_ARCH}-unknown-linux-gnu; \
    }; \
    # smoke tests
    [ "$(command -v composer)" = '/usr/local/bin/composer' ]; \
    [ "$(command -v overmind)" = '/usr/local/bin/overmind' ]; \
    [ "$(command -v watchexec)" = '/usr/local/bin/watchexec' ]; \
    [ "$(command -v tmux)" = '/usr/bin/tmux' ]; \
    composer --version; \
    overmind --version; \
    watchexec --version

# ---
# 8. Verify the image
#
# Version 8.5 ships no goss file. These checks replace it and run on every
# CPU type that CI builds.
RUN set -eux; \
    # PHP extensions
    php --version; \
    for ext in bcmath calendar ctype exif fileinfo ftp gd intl json mbstring \
               memcached openssl pcntl pdo pdo_mysql pdo_pgsql redis sockets \
               tokenizer xml xsl zip; do \
        php -m | grep -qix "$ext" || { echo "missing PHP extension: $ext" >&2; exit 1; }; \
    done; \
    php -m | grep -qx "Zend OPcache" || { echo "missing PHP extension: OPcache" >&2; exit 1; }; \
    php -m | grep -qx "xdebug" || { echo "missing PHP extension: xdebug" >&2; exit 1; }; \
    # PHP configuration
    php -i | grep -qE '^memory_limit => 1024M => 1024M$' || { echo "memory_limit is not 1024M" >&2; exit 1; }; \
    # iconv handles the Euro symbol
    php -d error_reporting=22527 -d display_errors=1 \
        -r 'var_dump(iconv("UTF-8", "UTF-8//IGNORE", "This is the Euro symbol €"));' \
        | grep -q 'string(27)' || { echo "iconv does not handle the Euro symbol" >&2; exit 1; }; \
    # fixuid is present and setuid root
    [ "$(stat -c '%a %U %G' /usr/local/bin/fixuid)" = '4755 root root' ] || { echo "fixuid is not setuid root" >&2; exit 1; }; \
    [ -f /etc/fixuid/config.yml ] || { echo "missing /etc/fixuid/config.yml" >&2; exit 1; }; \
    # the non-root user exists with the expected ids
    [ "$(id -u user)" = '1000' ] || { echo "user uid is not 1000" >&2; exit 1; }; \
    [ "$(id -g user)" = '1000' ] || { echo "user gid is not 1000" >&2; exit 1; }; \
    [ "$(id -gn user)" = 'user' ] || { echo "user group is not named user" >&2; exit 1; }; \
    # packages the image depends on at run time
    for cmd in curl git ssh 7z unzip tmux; do \
        command -v "$cmd" >/dev/null || { echo "missing command: $cmd" >&2; exit 1; }; \
    done; \
    [ -e /usr/share/zoneinfo/UTC ] || { echo "missing tzdata" >&2; exit 1; }; \
    # database clients
    mysql --version; \
    mysqldump --version; \
    pg_dump --version; \
    pg_restore --version
